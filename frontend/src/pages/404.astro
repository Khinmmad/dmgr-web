---
import Base from "../layouts/Base.astro";
import T from "../components/T.astro";

const base = import.meta.env.BASE_URL;
---
<Base title="404 — dmgr">
  <main class="relative min-h-screen grid place-items-center text-center px-6 overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-32 left-1/4 w-[30rem] h-[30rem] rounded-full bg-mauve/20 blur-[120px] animate-drift"></div>
      <div class="absolute bottom-0 right-1/4 w-[26rem] h-[26rem] rounded-full bg-blue/20 blur-[120px] animate-drift" style="animation-delay:-8s"></div>
    </div>
    <div>
      <div class="text-8xl sm:text-9xl font-extrabold tracking-tight text-gradient">404</div>
      <p class="mt-5 text-lg text-subtext">
        <T en="This device could not be found." es="Este dispositivo no se pudo encontrar." />
      </p>
      <a
        href={base}
        class="mt-8 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-mauve to-blue px-6 py-3 font-bold text-base shadow-xl shadow-blue/30 hover:-translate-y-0.5 transition"
      >
        ← <T en="Back to dmgr" es="Volver a dmgr" />
      </a>
    </div>
  </main>
</Base>
