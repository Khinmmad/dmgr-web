---
import T from "./T.astro";

const features = [
  {
    color: "blue",
    icon: `<path d="M4 6h16M4 12h16M4 18h10"/>`,
    en: { t: "Device browser", d: "Every device grouped by bus — USB, PCIe, audio, GPU, network. Kernel noise hidden by default, with a tree view and instant search." },
    es: { t: "Explorador de dispositivos", d: "Cada dispositivo agrupado por bus — USB, PCIe, audio, GPU, red. El ruido del kernel oculto por defecto, con vista en árbol y búsqueda instantánea." },
  },
  {
    color: "mauve",
    icon: `<path d="M10.3 3.6a2 2 0 013.4 0l.6 1a2 2 0 002 1l1.1-.1a2 2 0 011.8 3l-.6 1a2 2 0 000 2.2l.6 1a2 2 0 01-1.8 3l-1.1-.1a2 2 0 00-2 1l-.6 1a2 2 0 01-3.4 0l-.6-1a2 2 0 00-2-1l-1.1.1a2 2 0 01-1.8-3l.6-1a2 2 0 000-2.2l-.6-1a2 2 0 011.8-3l1.1.1a2 2 0 002-1z"/><circle cx="12" cy="12" r="2.5"/>`,
    en: { t: "Driver actions, Windows-style", d: "Enable or disable a device, install / change a driver, or uninstall it — the way you already know from Windows Device Manager." },
    es: { t: "Acciones de driver estilo Windows", d: "Activa o desactiva un dispositivo, instala / cambia un driver o desinstálalo — como ya conoces del Administrador de dispositivos de Windows." },
  },
  {
    color: "teal",
    icon: `<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/>`,
    en: { t: "Deep properties", d: "View every sysfs property and edit the ones the kernel allows. An Advanced panel surfaces PCIe link speed, IRQs, USB speeds and power state." },
    es: { t: "Propiedades a fondo", d: "Mira cada propiedad de sysfs y edita las que el kernel permite. Un panel avanzado muestra velocidad de enlace PCIe, IRQs, velocidades USB y energía." },
  },
  {
    color: "green",
    icon: `<path d="M3 10v4h4l5 5V5L7 10H3z"/><path d="M16.5 8.5a5 5 0 010 7M19 6a8 8 0 010 12"/>`,
    en: { t: "Audio that just works", d: "List every output, see the active one, and switch in one click with volume & mute. PipeWire / PulseAudio / ALSA on Linux, Core Audio on Windows." },
    es: { t: "Audio que simplemente funciona", d: "Lista cada salida, ve la activa y cámbiala en un clic con volumen y silencio. PipeWire / PulseAudio / ALSA en Linux, Core Audio en Windows." },
  },
  {
    color: "sapphire",
    icon: `<path d="M7 7l10 10-5 4V3l5 4L7 17"/>`,
    en: { t: "Bluetooth control", d: "Connect, disconnect and trust paired devices and toggle the adapter on Linux; list devices and flip the radio on Windows." },
    es: { t: "Control de Bluetooth", d: "Conecta, desconecta y confía dispositivos emparejados y enciende el adaptador en Linux; lista dispositivos y enciende la radio en Windows." },
  },
  {
    color: "peach",
    icon: `<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>`,
    en: { t: "Kernel modules", d: "List loaded modules, read modinfo, and load or unload with modprobe — all from the UI, no terminal needed." },
    es: { t: "Módulos del kernel", d: "Lista los módulos cargados, lee modinfo y carga o descarga con modprobe — todo desde la interfaz, sin terminal." },
  },
  {
    color: "pink",
    icon: `<path d="M21 2v6h-6M3 12a9 9 0 0115-6.7L21 8M3 22v-6h6M21 12a9 9 0 01-15 6.7L3 16"/>`,
    en: { t: "Live hotplug", d: "Plug or unplug anything and the list refreshes itself — via udev on Linux and device notifications on Windows." },
    es: { t: "Hotplug en vivo", d: "Conecta o desconecta cualquier cosa y la lista se actualiza sola — vía udev en Linux y notificaciones de dispositivo en Windows." },
  },
  {
    color: "yellow",
    icon: `<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5.6 5.6L4.2 4.2M19.8 19.8l-1.4-1.4M18.4 5.6l1.4-1.4M4.2 19.8l1.4-1.4"/>`,
    en: { t: "Yours to customize", d: "Detects your distro, session and GPU. Light / dark themes, accent colors, density and remembered layout — make it feel like home." },
    es: { t: "Tuyo para personalizar", d: "Detecta tu distro, sesión y GPU. Temas claro / oscuro, colores de acento, densidad y diseño recordado — siéntelo como en casa." },
  },
];

const ring: Record<string, string> = {
  blue: "text-blue bg-blue/10 ring-blue/20",
  mauve: "text-mauve bg-mauve/10 ring-mauve/20",
  teal: "text-teal bg-teal/10 ring-teal/20",
  green: "text-green bg-green/10 ring-green/20",
  sapphire: "text-sapphire bg-sapphire/10 ring-sapphire/20",
  peach: "text-peach bg-peach/10 ring-peach/20",
  pink: "text-pink bg-pink/10 ring-pink/20",
  yellow: "text-yellow bg-yellow/10 ring-yellow/20",
};
---
<section id="features" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-2xl mx-auto text-center mb-16">
      <p class="reveal text-sm font-semibold uppercase tracking-widest text-blue mb-3">
        <T en="Everything in one place" es="Todo en un solo lugar" />
      </p>
      <h2 class="reveal text-3xl sm:text-5xl font-extrabold tracking-tight" data-delay="1">
        <T en="One app for all your devices" es="Una app para todos tus dispositivos" />
      </h2>
      <p class="reveal mt-4 text-subtext text-lg" data-delay="2">
        <T
          en="dmgr brings the clarity of Windows Device Manager to every platform — and goes further."
          es="dmgr lleva la claridad del Administrador de dispositivos de Windows a cada plataforma — y va más allá."
        />
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {features.map((f, i) => (
        <div class="reveal glow-card rounded-2xl border border-surface0 bg-mantle/60 p-6" data-delay={(i % 4) + 1}>
          <div class={`grid place-items-center w-12 h-12 rounded-xl ring-1 mb-5 ${ring[f.color]}`}>
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
          </div>
          <h3 class="text-lg font-bold mb-2"><T en={f.en.t} es={f.es.t} /></h3>
          <p class="text-sm text-subtext leading-relaxed"><T en={f.en.d} es={f.es.d} /></p>
        </div>
      ))}
    </div>
  </div>
</section>
