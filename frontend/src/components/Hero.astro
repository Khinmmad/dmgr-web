---
import T from "./T.astro";
import { GITHUB_URL } from "../lib/releases";
---
<section id="top" class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-28">
  <!-- animated gradient blobs -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-32 -left-24 w-[34rem] h-[34rem] rounded-full bg-mauve/25 blur-[120px] animate-drift"></div>
    <div class="absolute top-10 right-0 w-[30rem] h-[30rem] rounded-full bg-blue/25 blur-[120px] animate-drift" style="animation-delay:-6s"></div>
    <div class="absolute bottom-0 left-1/3 w-[28rem] h-[28rem] rounded-full bg-teal/20 blur-[120px] animate-drift" style="animation-delay:-12s"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,transparent_40%,var(--color-base)_85%)]"></div>
  </div>

  <div class="mx-auto max-w-5xl px-5 sm:px-8 text-center">
    <div class="reveal inline-flex items-center gap-2 rounded-full border border-surface0 bg-mantle/60 px-4 py-1.5 text-xs sm:text-sm text-subtext mb-7">
      <span class="w-2 h-2 rounded-full bg-green animate-glow"></span>
      <T en="Free &amp; open source · Linux · Windows · macOS" es="Libre y de código abierto · Linux · Windows · macOS" />
    </div>

    <h1 class="reveal text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.05]">
      <T en="Your hardware," es="Tu hardware," /><br />
      <span class="text-gradient"><T en="finally manageable." es="por fin manejable." /></span>
    </h1>

    <p class="reveal mt-6 max-w-2xl mx-auto text-base sm:text-xl text-subtext leading-relaxed" data-delay="1">
      <T
        en="A modern, Windows-style Device Manager for every OS. Browse devices, switch audio outputs, manage Bluetooth, drivers and kernel modules — from one clean, fast desktop app."
        es="Un administrador de dispositivos moderno estilo Windows para cualquier SO. Explora dispositivos, cambia salidas de audio, gestiona Bluetooth, drivers y módulos del kernel — desde una app de escritorio limpia y rápida."
      />
    </p>

    <div class="reveal mt-9 flex flex-col sm:flex-row items-center justify-center gap-4" data-delay="2">
      <a
        id="hero-download"
        href="#downloads"
        class="group inline-flex items-center gap-2.5 rounded-xl bg-gradient-to-r from-mauve to-blue px-7 py-3.5 text-base font-bold text-base shadow-xl shadow-blue/30 hover:shadow-blue/50 hover:-translate-y-0.5 transition-all"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg>
        <span><T en="Download for" es="Descargar para" /> <span id="hero-os-label">Linux</span></span>
      </a>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2.5 rounded-xl border border-surface1 bg-surface0/40 px-7 py-3.5 text-base font-semibold text-text hover:bg-surface0 transition"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 016 0C17.3 4.6 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
        <T en="Star on GitHub" es="Estrella en GitHub" />
      </a>
    </div>

    <p class="reveal mt-4 text-xs text-overlay0" data-delay="3">
      <T en="Latest release" es="Última versión" /> <span data-version class="text-subtext font-semibold">v2.1.0</span> ·
      <T en=".deb · .rpm · AppImage · AUR" es=".deb · .rpm · AppImage · AUR" />
    </p>
  </div>

  <!-- hero screenshot -->
  <div class="reveal mt-16 px-5 sm:px-8" data-delay="2">
    <div class="relative mx-auto max-w-5xl">
      <div class="absolute -inset-4 bg-gradient-to-r from-mauve/30 via-blue/30 to-teal/30 blur-2xl rounded-3xl animate-glow"></div>
      <div class="relative rounded-2xl border border-surface0 bg-mantle shadow-2xl overflow-hidden">
        <div class="flex items-center gap-1.5 px-4 h-9 bg-crust border-b border-surface0">
          <span class="w-3 h-3 rounded-full bg-red/80"></span>
          <span class="w-3 h-3 rounded-full bg-yellow/80"></span>
          <span class="w-3 h-3 rounded-full bg-green/80"></span>
          <span class="ml-3 text-xs text-overlay0">dmgr — Device Manager</span>
        </div>
        <img
          src={`${import.meta.env.BASE_URL}screenshots/devices.png`}
          alt="dmgr device list"
          width="1196"
          height="799"
          loading="eager"
          class="w-full block"
        />
      </div>
    </div>
  </div>
</section>
