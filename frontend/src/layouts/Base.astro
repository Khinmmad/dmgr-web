---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "dmgr — A modern Device Manager for Linux, Windows & macOS",
  description = "Browse and manage your hardware — devices, drivers, audio, Bluetooth and kernel modules — from a clean, fast desktop app. Free & open source.",
} = Astro.props;

const base = import.meta.env.BASE_URL; // "/" or "/dmgr-web/"
const ogImage = new URL(`${base}screenshots/devices.png`, Astro.site).href;
const canonical = new URL(base, Astro.site).href;

// Structured data so search engines understand this is a free desktop app.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "dmgr",
  description,
  url: canonical,
  image: ogImage,
  operatingSystem: "Linux, Windows 10, Windows 11",
  applicationCategory: "UtilitiesApplication",
  license: "https://opensource.org/licenses/MIT",
  downloadUrl: "https://github.com/Khinmmad/dmgr/releases/latest",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <meta name="theme-color" content="#1e1e2e" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Set language before paint to avoid a flash of the wrong language. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("dmgr-lang");
          var detected = (navigator.language || "en").toLowerCase().indexOf("es") === 0 ? "es" : "en";
          var lang = saved || detected;
          document.documentElement.setAttribute("data-lang", lang);
          document.documentElement.setAttribute("lang", lang);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-base text-text">
    <div id="scroll-progress" aria-hidden="true"></div>
    <slot />
    <button id="to-top" aria-label="Back to top">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5m0 0l-6 6m6-6l6 6"/></svg>
    </button>

    <script>
      import { FALLBACK, RELEASES_PAGE, type Platform } from "../lib/releases";

      const API = (import.meta.env.PUBLIC_API_BASE ?? "").replace(/\/$/, "");

      // ── Language toggle ──────────────────────────────────────────────────
      const TITLES: Record<string, string> = {
        en: "dmgr — A modern Device Manager for Linux, Windows & macOS",
        es: "dmgr — Un Administrador de Dispositivos moderno para Linux, Windows y macOS",
      };
      function setLang(lang: string) {
        document.documentElement.setAttribute("data-lang", lang);
        document.documentElement.setAttribute("lang", lang);
        if (TITLES[lang] && document.title.startsWith("dmgr —")) document.title = TITLES[lang];
        try {
          localStorage.setItem("dmgr-lang", lang);
        } catch (e) {}
        document.querySelectorAll<HTMLElement>("[data-lang-set]").forEach((b) => {
          b.classList.toggle("is-active", b.dataset.langSet === lang);
        });
      }
      document.querySelectorAll<HTMLElement>("[data-lang-set]").forEach((btn) => {
        btn.addEventListener("click", () => setLang(btn.dataset.langSet!));
      });
      setLang(document.documentElement.getAttribute("data-lang") || "en");

      // ── Scroll reveal ────────────────────────────────────────────────────
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in-view");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // ── Nav background on scroll ─────────────────────────────────────────
      const nav = document.getElementById("nav");
      if (nav) {
        const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 24);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }

      // ── Scroll progress bar + back-to-top ────────────────────────────────
      const prog = document.getElementById("scroll-progress");
      const toTop = document.getElementById("to-top");
      const onScrollFx = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        if (prog) prog.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + "%";
        if (toTop) toTop.classList.toggle("show", h.scrollTop > 600);
      };
      onScrollFx();
      window.addEventListener("scroll", onScrollFx, { passive: true });
      toTop?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));

      // ── Mobile menu ──────────────────────────────────────────────────────
      const menuBtn = document.getElementById("menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      menuBtn?.addEventListener("click", () => mobileMenu?.classList.toggle("hidden"));
      mobileMenu?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => mobileMenu.classList.add("hidden"))
      );

      // ── GitHub stars (cached per session) ────────────────────────────────
      function showStars(n: number) {
        const txt = n >= 1000 ? (n / 1000).toFixed(1) + "k" : String(n);
        document.querySelectorAll<HTMLElement>("[data-stars]").forEach((el) => {
          el.textContent = txt;
          el.closest<HTMLElement>("[data-stars-wrap]")?.classList.remove("hidden");
        });
      }
      try {
        const cached = sessionStorage.getItem("dmgr-stars");
        if (cached) {
          showStars(Number(cached));
        } else {
          fetch("https://api.github.com/repos/Khinmmad/dmgr")
            .then((r) => (r.ok ? r.json() : Promise.reject()))
            .then((j) => {
              if (typeof j.stargazers_count === "number") {
                sessionStorage.setItem("dmgr-stars", String(j.stargazers_count));
                showStars(j.stargazers_count);
              }
            })
            .catch(() => {});
        }
      } catch (e) {}

      // ── Hero screenshot tabs (auto-rotate until user interacts) ──────────
      const shotTabs = Array.from(document.querySelectorAll<HTMLElement>("[data-shot-tab]"));
      const shotImgs = Array.from(document.querySelectorAll<HTMLElement>("[data-shot-img]"));
      let shotIdx = 0;
      let shotTimer: number | undefined;
      function showShot(i: number) {
        shotIdx = i;
        shotTabs.forEach((t, j) => t.classList.toggle("active", j === i));
        shotImgs.forEach((s, j) => s.classList.toggle("active", j === i));
      }
      shotTabs.forEach((t, i) =>
        t.addEventListener("click", () => {
          window.clearInterval(shotTimer);
          showShot(i);
        })
      );
      if (shotTabs.length > 1 && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        shotTimer = window.setInterval(() => showShot((shotIdx + 1) % shotTabs.length), 5000);
      }

      // ── Copy-to-clipboard buttons ────────────────────────────────────────
      document.querySelectorAll<HTMLElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy || "");
            const prev = btn.textContent;
            btn.textContent = "✓";
            btn.classList.add("copied");
            window.setTimeout(() => {
              btn.textContent = prev;
              btn.classList.remove("copied");
            }, 1400);
          } catch (e) {}
        });
      });

      // ── Detect OS for the hero primary download ──────────────────────────
      function detectPlatform(): Platform {
        const ua = navigator.userAgent.toLowerCase();
        const p = (navigator.platform || "").toLowerCase();
        if (ua.includes("win") || p.includes("win")) return "windows";
        if (ua.includes("mac") || p.includes("mac")) return "macos";
        if (ua.includes("android")) return "debian";
        return "debian"; // generic Linux
      }

      // ── Downloads: start from fallback, upgrade with live backend data ───
      type Info = { available: boolean; url?: string; filename?: string; command?: string };
      let data: Record<string, Info> = { ...FALLBACK } as any;

      function applyData() {
        document.querySelectorAll<HTMLElement>("[data-platform]").forEach((card) => {
          const plat = card.dataset.platform as string;
          const info = data[plat];
          const btn = card.querySelector<HTMLAnchorElement>("[data-dl-btn]");
          const soon = card.querySelector<HTMLElement>("[data-soon]");
          if (!info || !info.available) {
            card.classList.add("opacity-60");
            if (soon) soon.classList.remove("hidden");
            if (btn) {
              btn.removeAttribute("href");
              btn.classList.add("pointer-events-none", "opacity-50");
            }
            return;
          }
          card.classList.remove("opacity-60");
          if (soon) soon.classList.add("hidden");
          if (btn) {
            btn.classList.remove("pointer-events-none", "opacity-50");
            // Prefer the counting redirect endpoint when the backend is up.
            btn.href = API ? `${API}/api/download/${plat}` : info.url || RELEASES_PAGE;
            if (API) btn.setAttribute("target", "_self");
          }
        });
      }

      function countUp(el: HTMLElement, to: number) {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches || to <= 0) {
          el.textContent = to.toLocaleString();
          return;
        }
        const start = performance.now();
        const dur = 900;
        const tick = (t: number) => {
          const p = Math.min((t - start) / dur, 1);
          el.textContent = Math.round(to * (1 - Math.pow(1 - p, 3))).toLocaleString();
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      function applyStats(stats: Record<string, number>) {
        let total = 0;
        for (const k in stats) total += stats[k] || 0;
        document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
          const plat = el.dataset.count as string;
          const n = stats[plat] || 0;
          countUp(el, n);
          el.closest<HTMLElement>("[data-count-wrap]")?.classList.toggle("hidden", n <= 0);
        });
        const totalEl = document.getElementById("dl-total");
        if (totalEl && total > 0) {
          countUp(totalEl, total);
          document.getElementById("dl-total-wrap")?.classList.remove("hidden");
        }
      }

      applyData();

      if (API) {
        fetch(`${API}/api/releases`)
          .then((r) => (r.ok ? r.json() : Promise.reject()))
          .then((j) => {
            if (j && j.platforms) {
              data = j.platforms;
              applyData();
            }
            if (j && j.version) {
              document
                .querySelectorAll<HTMLElement>("[data-version]")
                .forEach((el) => (el.textContent = j.version));
            }
          })
          .catch(() => {});
        fetch(`${API}/api/stats`)
          .then((r) => (r.ok ? r.json() : Promise.reject()))
          .then((j) => applyStats(j || {}))
          .catch(() => {});
      }

      // Hero primary button → user's OS.
      const heroBtn = document.getElementById("hero-download") as HTMLAnchorElement | null;
      const heroLabel = document.getElementById("hero-os-label");
      if (heroBtn) {
        const plat = detectPlatform();
        const info = data[plat];
        const names: Record<string, string> = {
          windows: "Windows",
          macos: "macOS",
          debian: "Linux",
          fedora: "Fedora",
          arch: "Arch",
          appimage: "Linux",
        };
        if (heroLabel) heroLabel.textContent = names[plat] || "Linux";
        heroBtn.href = info && info.available
          ? API
            ? `${API}/api/download/${plat}`
            : info.url || "#downloads"
          : "#downloads";
      }
    </script>
  </body>
</html>
